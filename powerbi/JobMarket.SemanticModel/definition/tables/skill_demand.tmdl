table skill_demand

	measure 'Skill share' = DIVIDE(SUM(skill_demand[share_pct]), 100)
		formatString: 0%

	measure 'Postings mentioning' = SUM(skill_demand[postings])
		formatString: #,0

	measure 'Data analyst postings analysed' = CALCULATE(SUM(skill_demand[postings]), skill_demand[type] = "total")
		formatString: #,0

	measure 'SQL share' = CALCULATE([Skill share], skill_demand[skill] = "SQL")
		formatString: 0%

	measure 'Power BI share' = CALCULATE([Skill share], skill_demand[skill] = "Power BI")
		formatString: 0%

	measure 'Tableau share' = CALCULATE([Skill share], skill_demand[skill] = "Tableau")
		formatString: 0%

	measure 'Remote mention share' = CALCULATE([Skill share], skill_demand[skill] = "remote")
		formatString: 0%

	measure 'Work from home mention share' = CALCULATE([Skill share], skill_demand[skill] = "work from home")
		formatString: 0%

	measure 'Hybrid mention share' = CALCULATE([Skill share], skill_demand[skill] = "hybrid")
		formatString: 0%

	column type
		dataType: string
		summarizeBy: none
		sourceColumn: type

	column skill
		dataType: string
		summarizeBy: none
		sourceColumn: skill

	column postings
		dataType: int64
		summarizeBy: none
		sourceColumn: postings

	column share_pct
		dataType: double
		summarizeBy: none
		sourceColumn: share_pct

	partition skill_demand = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\skill_demand_counts.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"type", "skill", "postings", "share_pct"}),
					Typed = Table.TransformColumnTypes(Selected, {{"type", type text}, {"skill", type text}, {"postings", Int64.Type}, {"share_pct", type number}}, "en-US")
				in
					Typed
